<?xml version="1.0"?>
<sdf version="1.7">

    <xmacro_include uri="model://rm25_example_robot/rm25_example_robot.def.xmacro" />

    <xmacro_define_value name="global_armor_sticker_type" value="num3" />
    <xmacro_define_value name="chassis_height" value="0.076" />
    <xmacro_define_value name="gimbal_yaw_height" value="0.1376" />
    <xmacro_define_value name="gimbal_pitch_height" value="0.16" />

    <model name="simulation_robot_gz">

        <pose>0 0 0.15 0 0 0</pose>
        <xmacro_block
            name="rm25_example_robot"
            sticker_type="${global_armor_sticker_type}"
            chassis_height="${chassis_height}"
            gimbal_yaw_height="${gimbal_yaw_height}"
            gimbal_pitch_height="${gimbal_pitch_height}"/>

        <joint name="front_rplidar_a2_joint" type="fixed">
            <pose relative_to="chassis">0.155 0 0.1 0 0 0</pose>
            <parent>chassis</parent>
            <child>front_rplidar_a2</child>
        </joint>

        <link name="front_rplidar_a2">
            <pose relative_to="front_rplidar_a2_joint">0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0.02 0 0 0</pose>
                <xmacro_block name="inertia_cylinder" m="0.005" r="0.04" l="0.04" />
            </inertial>
            <visual name="visual">
                <xmacro_block name="geometry_mesh" uri="model://rplidar_a2/meshes/rplidar_a2.dae"/>
            </visual>
            <collision name="collision">
                <pose>0 0 0.02 0 0 0</pose>
                <xmacro_block name="geometry_cylinder" r="0.04" l="0.04"/>
            </collision>
            <sensor name="front_rplidar_a2" type="gpu_lidar">
                <topic>/scan</topic>
                <pose>0 0 0.03 0 0 0</pose>
                <alwaysOn>1</alwaysOn>
                <visualize>true</visualize>
                <update_rate>10</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>400</samples>
                            <resolution>1.0</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>6.28000020980835</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.15</min>
                        <max>12.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </sensor>
        </link>

        <plugin
            filename="ignition-gazebo-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <left_joint>rear_left_wheel_joint</left_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <wheel_separation>0.388</wheel_separation>
            <wheel_radius>0.0758</wheel_radius>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>

    </model>
</sdf>
